{
    "name": "slowpoke/symfony",
    "description": "Sends each Symfony request, console command and Messenger message, with the file:line origin of every Doctrine query, to the local Slowpoke agent.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony",
        "doctrine",
        "performance",
        "n-plus-one",
        "slowpoke"
    ],
    "homepage": "https://github.com/christiancannata/slowpoke-symfony",
    "authors": [
        {
            "name": "Christian Cannata",
            "email": "christiancannata@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/christiancannata/slowpoke-symfony/issues",
        "source": "https://github.com/christiancannata/slowpoke-symfony"
    },
    "require": {
        "php": "^7.4|^8.0",
        "symfony/config": "^5.4|^6.4|^7.0",
        "symfony/dependency-injection": "^5.4|^6.4|^7.0",
        "symfony/http-kernel": "^5.4|^6.4|^7.0"
    },
    "require-dev": {
        "doctrine/dbal": "^3.3|^4.0",
        "doctrine/doctrine-bundle": "^2.7",
        "phpunit/phpunit": "^9.6|^10.5|^11.0|^12.0",
        "symfony/console": "^5.4|^6.4|^7.0",
        "symfony/framework-bundle": "^5.4|^6.4|^7.0",
        "symfony/messenger": "^5.4|^6.4|^7.0",
        "symfony/twig-bundle": "^5.4|^6.4|^7.0",
        "symfony/yaml": "^5.4|^6.4|^7.0"
    },
    "suggest": {
        "doctrine/doctrine-bundle": "registers the DBAL middleware that records queries (DBAL 3.3+ or 4)",
        "symfony/console": "traces the commands cron runs, one trace each",
        "symfony/messenger": "traces each message handled by a worker"
    },
    "conflict": {
        "doctrine/dbal": "<3.3"
    },
    "autoload": {
        "psr-4": {
            "Slowpoke\\Symfony\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Slowpoke\\Symfony\\Tests\\": "tests/",
            "App\\": "tests/App/src/"
        }
    },
    "config": {
        "lock": false,
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
